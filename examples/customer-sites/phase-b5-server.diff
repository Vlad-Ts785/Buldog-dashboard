+  return e ? e.name : null;
+}
+// Новое написание к площадке (склейка по точке); уже есть - ничего.
+async function addText_(db, siteId, text, uses) {
+  const [ex] = await db.query(`SELECT text FROM customer_site_texts WHERE site_id = ?`, [siteId]);
+  if (ex.some((x) => textKey(x.text) === textKey(text))) return false;
+  await db.query(`INSERT INTO customer_site_texts (site_id, text, uses) VALUES (?, ?, ?)`, [siteId, text, uses || 0]);
+  return true;
+}
+// Создать площадку (общая часть «площадки со 2-й заявки» и «Сохранить как площадку»).
+async function insertSite_(db, s, by, detailExtra) {
+  const [ins] = await db.query(
+    `INSERT INTO customer_sites (customer_entity_id, customer_name, name, address, lat, lon, point_source, contact_name, contact_phone,
+       load_count, unload_count, first_used, last_used, needs_check, check_note, created_by, updated_by)
+     VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`,
+    [s.customer_entity_id || null, s.customer_name, s.name || defaultName(s.address), s.address, s.lat == null ? null : s.lat, s.lon == null ? null : s.lon,
+      s.lat == null ? null : (s.point_source || "order"), s.contact_name || null, s.contact_phone || null, s.load_count || 0, s.unload_count || 0,
+      s.first_used || null, s.last_used || null, s.needs_check ? 1 : 0, s.check_note || null, String(by).slice(0, 255), String(by).slice(0, 255)]);
+  await db.query(`INSERT INTO customer_site_texts (site_id, text, uses) VALUES (?, ?, ?)`, [ins.insertId, s.address, s.text_uses || 0]);
+  await writeSiteHistory(db, ins.insertId, "create", Object.assign(diffFields(null, s), detailExtra || {}), by);
+  return ins.insertId;
+}
+// Ссылка заявки на площадку (только если ссылки ещё нет) + счётчик/даты/написание площадки.
+async function linkOrder_(conn, o, side, siteId, text) {
+  const col = side === "load" ? "load_site_id" : "unload_site_id";
+  const [u] = await conn.query(`UPDATE plan_orders SET ${col} = ? WHERE id = ? AND ${col} IS NULL`, [siteId, o.id]);
+  if (!u.affectedRows) return false;
+  await touchUse(conn, siteId, side, fmtDate(o.service_date), text);
+  return true;
+}
+
+// После сохранения заявки (любой экран): для каждой стороны без площадки -
+//  1) написание адреса совпало с написанием ЖИВОЙ площадки этого заказчика -> привязать (своя точка заявки
