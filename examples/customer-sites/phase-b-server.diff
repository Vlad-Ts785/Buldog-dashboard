new file mode 100644
index 0000000..4614a9e
--- /dev/null
+++ b/api/lib/customer-sites.js
@@ -0,0 +1,306 @@
+"use strict";
+// Площадки заказчика (26.09.2026, фаза Б плана plans/2026-09-26-customer-addresses-and-price-geo.md в
+// репозитории дашборда). Место погрузки/выгрузки хранится ОДИН раз у заказчика (customer_sites), заявка
+// ссылается на него (plan_orders.load_site_id / unload_site_id) и берёт с него точку, контакт на месте и
+// пометку водителю. Таблицы - import/customer-sites-schema.sql, первое наполнение - oneoff/customer-sites-seed.js.
+//
+// Правила безопасности адресов (Влад 26.09: «уехать в другой город или другую часть Москвы - проблема»):
+//  - точку площадки ставит только человек - ссылкой Яндекс.Карт или координатами; поиск по тексту сюда
+//    не пишет никогда (resolvePoint с search:false);
+//  - менеджер и логист ставят точку только площадке БЕЗ точки (форма заявки, «Запомнить точку»); поменять
+//    уже стоящую точку может только admin в Справочниках (решение Влада 26.09: «точки ставит менеджер»);
+//  - каждая правка - в customer_site_history «было -> стало» (кто, когда); удаления нет, только архив.
+// Время в customer_site_history - UTC (DEFAULT CURRENT_TIMESTAMP), отдаётся сырым ISO, экран сам
+// переводит в МСК (правило CLAUDE.md «UTC на сервере, МСК на экране»).
+const addressPoint = require("./address-point.js");
+const { normalizeContact } = require("./contact-phone.js");
+
+const MAX_ = { customer_entity_id: 64, customer_name: 255, name: 120, address: 500, contact_name: 150, contact_phone: 64, driver_note: 300 };
+const READ_ROLES_ = ["admin", "manager", "logist"];
+const HIST_FIELDS_ = ["name", "address", "lat", "lon", "contact_name", "contact_phone", "driver_note", "customer_entity_id", "customer_name", "needs_check"];
+
+function clean(v, max) {
+  const s = String(v == null ? "" : v).replace(/\s+/g, " ").trim();
+  return s ? s.slice(0, max) : null;
+}
+// Ключ сравнения написаний адреса: регистр и лишние пробелы площадку не различают.
+function textKey(t) { return String(t || "").replace(/\s+/g, " ").trim().toLowerCase(); }
+function fmtDate(d) {
+  if (!d) return null; if (typeof d === "string") return d.slice(0, 10);
+  const dt = new Date(d); return dt.getFullYear() + "-" + String(dt.getMonth() + 1).padStart(2, "0") + "-" + String(dt.getDate()).padStart(2, "0");
+}
+// Короткое имя по умолчанию - первая часть адреса до запятой, без ссылок и координат (как при наполнении).
+function defaultName(address) {
+  let x = String(address || "").replace(/https?:\/\/\S+/g, " ").replace(/координаты\s*:?\s*-?\d{1,3}\.\d+\s*[,;]\s*-?\d{1,3}\.\d+/gi, " ")
+    .replace(/-?\d{1,3}\.\d{4,}\s*[,;]\s*-?\d{1,3}\.\d{4,}/g, " ").replace(/["«»]/g, "").replace(/\s+/g, " ").trim();
+  x = x.split(",")[0].trim() || x;
+  return x.slice(0, MAX_.name) || null;
+}
+
+// Точка из того, что вставил человек: ссылка Яндекс.Карт (короткая тоже - её раскрывает resolveLink) или
+// «широта, долгота». Пусто - { none: true }. Найденная поиском точка площадке не годится (правило Б1).
+async function parsePoint(text, resolveLink) {
+  const s = String(text == null ? "" : text).trim();
+  if (!s) return { none: true };
+  const r = await addressPoint.resolvePoint(s, { search: false, resolveLink });
+  if (!r || r.error || r.lat == null || r.lon == null) return { error: "Не вижу точки: вставьте ссылку Яндекс.Карт или координаты вида «55.75, 37.62»" };
+  if (!addressPoint.inRussia(r.lat, r.lon)) return { error: "Точка вне России - похоже, перепутаны широта и долгота" };
+  return { lat: Math.round(Number(r.lat) * 1e6) / 1e6, lon: Math.round(Number(r.lon) * 1e6) / 1e6 };
+}
+
+// «Имя · телефон» одной строкой (как поле контакта в заявке) -> тот же разбор, что у заявок (contact-phone.js).
+function readContact(raw) {
+  const s = clean(raw, 300);
+  if (!s) return { name: null, phone: null };
+  const r = normalizeContact(s, "");
+  return { name: clean(r.name, MAX_.contact_name), phone: clean(r.phone, MAX_.contact_phone) };
+}
+
+function histVal(v) {
+  if (v === undefined || v === null) return "";
+  if (typeof v === "boolean") return v ? "1" : "0";
+  const s = String(v).trim();
+  return /^-?\d+(\.\d+)?$/.test(s) ? String(Number(s)) : s;
+}
+// {поле: [было, стало]} только по реально изменённым полям из f (undefined - поле не присылали).
+function diffFields(before, f) {
+  const c = {};
+  HIST_FIELDS_.forEach((k) => {
+    if (f[k] === undefined) return;
+    const a = histVal(before ? before[k] : null), b = histVal(f[k]);
+    if (a !== b) c[k] = [a.slice(0, 160), b.slice(0, 160)];
+  });
+  return c;
+}
+
+function out(s, texts) {
+  const num = (v) => (v === null || v === undefined ? null : Number(v));
+  return {
+    id: s.id, customer_entity_id: s.customer_entity_id || null, customer_name: s.customer_name,
+    name: s.name || defaultName(s.address), address: s.address,
+    lat: num(s.lat), lon: num(s.lon), point_source: s.point_source || null,
+    contact_name: s.contact_name || null, contact_phone: s.contact_phone || null, driver_note: s.driver_note || null,
+    load_count: Number(s.load_count) || 0, unload_count: Number(s.unload_count) || 0,
+    uses: (Number(s.load_count) || 0) + (Number(s.unload_count) || 0),
+    first_used: fmtDate(s.first_used), last_used: fmtDate(s.last_used),
+    needs_check: !!Number(s.needs_check), check_note: s.check_note || null,
+    updated_at: s.updated_at ? new Date(s.updated_at).toISOString() : null,
+    archived: !!s.archived_at, texts: texts || [],
+  };
+}
+
+// Площадки заказчика: по юрлицу ИЛИ по названию (у 28 площадок заказчика без юрлица ключ - название).
+async function listForCustomer(db, customer, entity, opts) {
+  const c = clean(customer, MAX_.customer_name) || "", e = clean(entity, MAX_.customer_entity_id) || "";
+  if (!c && !e) return [];
+  const [rows] = await db.query(
+    `SELECT * FROM customer_sites
+      WHERE ${opts && opts.archived ? "1 = 1" : "archived_at IS NULL"}
+        AND ((? <> '' AND customer_entity_id = ?) OR (? <> '' AND customer_name = ?))
+      ORDER BY archived_at IS NOT NULL, (load_count + unload_count) DESC, id`, [e, e, c, c]);
+  if (!rows.length) return [];
+  const [texts] = await db.query(`SELECT site_id, text FROM customer_site_texts WHERE site_id IN (?) ORDER BY uses DESC, id`, [rows.map((r) => r.id)]);
+  const by = {}; texts.forEach((t) => { (by[t.site_id] = by[t.site_id] || []).push(t.text); });
+  return rows.map((r) => out(r, by[r.id] || [r.address]));
+}
+
+// Для списка заявок / задания водителю: id -> { id, name, driver_note, lat, lon, archived }. Точка площадки -
+// чтобы форма правки заявки, у которой своей точки нет (площадке точку поставили позже), подставила её.
+async function siteInfo(db, ids) {
+  const list = Array.from(new Set((ids || []).map(Number).filter((n) => Number.isInteger(n) && n > 0)));
+  if (!list.length) return {};
+  const [rows] = await db.query(`SELECT id, name, address, driver_note, lat, lon, archived_at FROM customer_sites WHERE id IN (?)`, [list]);
+  const by = {};
+  rows.forEach((r) => {
+    by[r.id] = { id: r.id, name: r.name || defaultName(r.address), driver_note: r.driver_note || null,
+      lat: r.lat == null ? null : Number(r.lat), lon: r.lon == null ? null : Number(r.lon), archived: !!r.archived_at };
+  });
+  return by;
+}
+
+// Какие из присланных id - живые (есть и не в архиве) площадки.
+async function activeIds(db, ids) {
+  const list = Array.from(new Set((ids || []).filter((n) => Number.isInteger(n) && n > 0)));
+  if (!list.length) return new Set();
+  const [rows] = await db.query(`SELECT id FROM customer_sites WHERE id IN (?) AND archived_at IS NULL`, [list]);
+  return new Set(rows.map((r) => r.id));
+}
+
+// Заявка стала ссылаться на площадку: счётчик стороны, первая/последняя дата, написание адреса.
+// updated_at = updated_at - счётчик не правка человека, «когда правили» не сдвигаем.
+async function touchUse(conn, siteId, side, date, text) {
+  if (!siteId) return;
+  const col = side === "load" ? "load_count" : "unload_count";
+  const d = /^\d{4}-\d{2}-\d{2}$/.test(String(date || "")) ? date : null;
+  await conn.query(
+    `UPDATE customer_sites SET ${col} = ${col} + 1,
+            first_used = CASE WHEN ? IS NULL THEN first_used ELSE LEAST(COALESCE(first_used, ?), ?) END,
+            last_used = CASE WHEN ? IS NULL THEN last_used ELSE GREATEST(COALESCE(last_used, ?), ?) END,
+            updated_at = updated_at
+      WHERE id = ?`, [d, d, d, d, d, d, siteId]);
+  const t = clean(text, MAX_.address);
+  if (!t) return;
+  const [ex] = await conn.query(`SELECT id, text FROM customer_site_texts WHERE site_id = ?`, [siteId]);
+  const hit = ex.find((x) => textKey(x.text) === textKey(t));
+  if (hit) await conn.query(`UPDATE customer_site_texts SET uses = uses + 1 WHERE id = ?`, [hit.id]);
+  else await conn.query(`INSERT INTO customer_site_texts (site_id, text, uses) VALUES (?, ?, 1)`, [siteId, t]);
+}
+
+function register(deps) {
+  const { app, pool, checkSession, requireRole_ } = deps;
+  const resolveLink = deps.resolveLink; // geocoder.resolveMapLink - раскрыть короткую ссылку Яндекса
+  pool.query(`CREATE TABLE IF NOT EXISTS customer_site_history (
+      id BIGINT NOT NULL AUTO_INCREMENT,
+      site_id INT NOT NULL,
+      action VARCHAR(20) NOT NULL,
+      detail TEXT,
+      changed_by VARCHAR(255) DEFAULT NULL,
+      changed_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
+      PRIMARY KEY (id), KEY k_site (site_id)
+    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci`)
+    .catch((e) => console.error("customer_site_history create:", e.message || e));
+
+  function fail(res, code, msg) { return res.status(code).json({ error: msg }); }
+  function p(req, k) { const b = req.body || {}; return b[k] !== undefined ? b[k] : (req.query || {})[k]; }
+  async function loadSite(db, id) { const [[s]] = await db.query(`SELECT * FROM customer_sites WHERE id = ?`, [id]); return s || null; }
+  async function history(db, siteId, action, detail, by) {
+    await db.query(`INSERT INTO customer_site_history (site_id, action, detail, changed_by) VALUES (?, ?, ?, ?)`,
+      [siteId, action, detail ? JSON.stringify(detail) : null, by]);
+    // общий журнал Справочников - та же строка «кто что тронул», что у юрлиц/людей/техники
+    await db.query(`INSERT INTO sprav_audit_log (entity_type, entity_id, action, changed_by) VALUES ('customer_site', ?, ?, ?)`,
+      [String(siteId), action, by]).catch(() => {});
+  }
+  async function textsOf(db, id) {
+    const [t] = await db.query(`SELECT text FROM customer_site_texts WHERE site_id = ? ORDER BY uses DESC, id`, [id]);
+    return t.map((x) => x.text);
+  }
+
+  // Площадки заказчика: форма заявки (подсказки) и карточка контрагента в Справочниках.
+  app.get("/api/sites", checkSession, requireRole_(...READ_ROLES_), async (req, res) => {
+    try {
+      const archived = req.userRole === "admin" && String(req.query.archived || "") === "1";
+      const sites = await listForCustomer(pool, req.query.customer, req.query.entity, { archived });
+      res.json({ sites, can_edit: req.userRole === "admin" });
+    } catch (err) { console.error("sites list:", err); fail(res, 500, String(err.message || err)); }
+  });
+
+  // Создать / изменить площадку - только admin (Справочники). point_text: ссылка или координаты;
+  // пустая строка - снять точку; не прислали - точку не трогаем.
+  app.post("/api/sites/save", checkSession, requireRole_("admin"), async (req, res) => {
+    try {
+      const id = Number(p(req, "id")) || 0;
+      const f = {};
+      if (p(req, "name") !== undefined) f.name = clean(p(req, "name"), MAX_.name);
+      if (p(req, "address") !== undefined) f.address = clean(p(req, "address"), MAX_.address);
+      if (p(req, "driver_note") !== undefined) f.driver_note = clean(p(req, "driver_note"), MAX_.driver_note);
+      if (p(req, "contact") !== undefined) { const c = readContact(p(req, "contact")); f.contact_name = c.name; f.contact_phone = c.phone; }
+      if (p(req, "point_text") !== undefined) {
+        const pt = await parsePoint(p(req, "point_text"), resolveLink);
+        if (pt.error) return fail(res, 400, pt.error);
+        if (pt.none) { f.lat = null; f.lon = null; } else { f.lat = pt.lat; f.lon = pt.lon; }
+      }
+      if (!id) {
+        f.customer_entity_id = clean(p(req, "customer_entity_id"), MAX_.customer_entity_id);
+        f.customer_name = clean(p(req, "customer_name"), MAX_.customer_name);
+        if (!f.customer_name) return fail(res, 400, "Не указан заказчик");
+        if (!f.address) return fail(res, 400, "Адрес площадки обязателен");
+        if (!f.name) f.name = defaultName(f.address);
+        const [ins] = await pool.query(
+          `INSERT INTO customer_sites (customer_entity_id, customer_name, name, address, lat, lon, point_source, contact_name, contact_phone,
+             driver_note, created_by, updated_by) VALUES (?,?,?,?,?,?,?,?,?,?,?,?)`,
+          [f.customer_entity_id, f.customer_name, f.name, f.address, f.lat == null ? null : f.lat, f.lon == null ? null : f.lon,
+            f.lat == null ? null : "manual", f.contact_name || null, f.contact_phone || null, f.driver_note || null, req.userEmail, req.userEmail]);
+        await pool.query(`INSERT INTO customer_site_texts (site_id, text, uses) VALUES (?, ?, 0)`, [ins.insertId, f.address]);
+        await history(pool, ins.insertId, "create", diffFields(null, f), req.userEmail);
+        const s = await loadSite(pool, ins.insertId);
+        return res.json({ ok: true, site: out(s, await textsOf(pool, s.id)) });
+      }
+      const before = await loadSite(pool, id);
+      if (!before) return fail(res, 404, "Площадка не найдена");
+      if (f.address === null) return fail(res, 400, "Адрес площадки обязателен");
+      if (f.name === null) f.name = defaultName(f.address || before.address);
+      // точку прислали (любую, в т.ч. ту же) - человек её посмотрел: пометка «проверить» снимается
+      if (f.lat !== undefined) f.needs_check = 0;
+      const c = diffFields(before, f);
+      if (!Object.keys(c).length) return res.json({ ok: true, site: out(before, await textsOf(pool, id)) });
+      const sets = [], args = [];
+      Object.keys(c).forEach((k) => { sets.push(k + " = ?"); args.push(f[k] === undefined ? null : f[k]); });
+      if (c.lat || c.lon) { sets.push("point_source = ?"); args.push(f.lat == null ? null : "manual"); }
+      if (c.needs_check) { sets.push("check_note = NULL"); }
+      sets.push("updated_by = ?"); args.push(req.userEmail, id);
+      await pool.query(`UPDATE customer_sites SET ${sets.join(", ")} WHERE id = ?`, args);
+      if (c.address) {
+        const known = (await textsOf(pool, id)).some((t) => textKey(t) === textKey(f.address));
+        if (!known) await pool.query(`INSERT INTO customer_site_texts (site_id, text, uses) VALUES (?, ?, 0)`, [id, f.address]);
+      }
+      const onlyPoint = Object.keys(c).every((k) => k === "lat" || k === "lon" || k === "needs_check");
+      await history(pool, id, onlyPoint ? "set_point" : "update", c, req.userEmail);
+      const s = await loadSite(pool, id);
+      res.json({ ok: true, site: out(s, await textsOf(pool, id)) });
+    } catch (err) {
+      console.error("sites save:", err);
+      if (err && err.code === "ER_DATA_TOO_LONG") return fail(res, 400, "Слишком длинное значение в одном из полей - сократите текст");
+      fail(res, 500, String(err.message || err));
+    }
+  });
+
+  // Точка площадке из формы заявки («Запомнить точку для площадки»). Менеджер/логист - только площадке
+  // без точки: уже стоящую точку меняет admin в Справочниках (условие lat IS NULL - в самом UPDATE,
+  // чтобы двое одновременно не перезаписали друг друга).
+  app.post("/api/sites/set_point", checkSession, requireRole_(...READ_ROLES_), async (req, res) => {
+    try {
+      const id = Number(p(req, "id")) || 0;
+      const before = id ? await loadSite(pool, id) : null;
+      if (!before || before.archived_at) return fail(res, 404, "Площадка не найдена");
+      const isAdmin = req.userRole === "admin";
+      if (before.lat != null && !isAdmin) return fail(res, 409, "У площадки уже есть точка - поменять её может администратор в Справочниках");
+      const pt = await parsePoint(p(req, "point_text"), resolveLink);
+      if (pt.error) return fail(res, 400, pt.error);
+      if (pt.none) return fail(res, 400, "Вставьте ссылку Яндекс.Карт или координаты вида «55.75, 37.62»");
+      const [u] = await pool.query(
+        `UPDATE customer_sites SET lat = ?, lon = ?, point_source = 'manual', needs_check = 0, check_note = NULL, updated_by = ?
+          WHERE id = ? AND archived_at IS NULL${isAdmin ? "" : " AND lat IS NULL"}`, [pt.lat, pt.lon, req.userEmail, id]);
+      if (!u.affectedRows) return fail(res, 409, "Точку площадке только что поставил кто-то другой - выберите площадку заново");
+      await history(pool, id, "set_point", diffFields(before, { lat: pt.lat, lon: pt.lon }), req.userEmail);
+      const s = await loadSite(pool, id);
+      res.json({ ok: true, site: out(s, await textsOf(pool, id)) });
+    } catch (err) { console.error("sites set_point:", err); fail(res, 500, String(err.message || err)); }
+  });
+
+  // В архив / из архива - только admin. Заявки, которые уже ссылаются на площадку, не меняются.
+  app.post("/api/sites/archive", checkSession, requireRole_("admin"), async (req, res) => {
+    try {
+      const id = Number(p(req, "id")) || 0; const on = String(p(req, "archived")) !== "0";
+      const before = id ? await loadSite(pool, id) : null;
+      if (!before) return fail(res, 404, "Площадка не найдена");
+      if (!!before.archived_at === on) return res.json({ ok: true, site: out(before, await textsOf(pool, id)) });
+      await pool.query(`UPDATE customer_sites SET archived_at = ${on ? "NOW()" : "NULL"}, updated_by = ? WHERE id = ?`, [req.userEmail, id]);
+      await history(pool, id, on ? "archive" : "restore", null, req.userEmail);
+      const s = await loadSite(pool, id);
+      res.json({ ok: true, site: out(s, await textsOf(pool, id)) });
+    } catch (err) { console.error("sites archive:", err); fail(res, 500, String(err.message || err)); }
+  });
+
+  // Журнал площадки (Справочники): кто, когда, что было -> что стало.
+  app.get("/api/sites/history", checkSession, requireRole_("admin"), async (req, res) => {
+    try {
+      const id = Number(req.query.id) || 0;
+      const [h] = await pool.query(`SELECT action, detail, changed_by, changed_at FROM customer_site_history WHERE site_id = ? ORDER BY changed_at DESC, id DESC LIMIT 100`, [id]);
+      const [u] = await pool.query(`SELECT email, name FROM access_users`);
+      const nameBy = {}; u.forEach((x) => { nameBy[x.email] = x.name || x.email; });
+      res.json({ history: h.map((x) => {
+        let detail = null; try { detail = x.detail ? JSON.parse(x.detail) : null; } catch (e) { detail = null; }
+        return { action: x.action, detail, by: nameBy[x.changed_by] || x.changed_by, at: new Date(x.changed_at).toISOString() };
+      }) });
+    } catch (err) { console.error("sites history:", err); fail(res, 500, String(err.message || err)); }
+  });
+}
+
+module.exports = register;
+module.exports.listForCustomer = listForCustomer;
+module.exports.siteInfo = siteInfo;
+module.exports.activeIds = activeIds;
+module.exports.touchUse = touchUse;
+module.exports.textKey = textKey;
+// для тестов
+module.exports._t = { parsePoint, readContact, diffFields, defaultName, clean, out };
diff --git a/api/lib/customer-sites.test.js b/api/lib/customer-sites.test.js
new file mode 100644
index 0000000..0da4cf7
--- /dev/null
+++ b/api/lib/customer-sites.test.js
@@ -0,0 +1,67 @@
+// Тесты customer-sites.js без сети и базы (подхватывает tests/unit.js). Главное - точку площадке ставит
+// только человек: ссылка или координаты, поиск по тексту НИКОГДА (правило Б1 плана адресов 26.09).
+"use strict";
+const assert = require("assert");
+const cs = require("./customer-sites.js");
+const T = cs._t;
+
+let n = 0;
