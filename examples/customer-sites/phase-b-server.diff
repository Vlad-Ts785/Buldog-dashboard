+-- Площадки заказчика, фаза Б-3/Б-4 (26.09.2026, plans/2026-09-26-customer-addresses-and-price-geo.md в
+-- репозитории дашборда). Разовая миграция, запускать ОДИН раз до выката кода (ALTER не повторяемый):
+--   mysql <база> < import/customer-sites-phase-b.sql
+-- 1) Заявка ссылается на площадку: выбор площадки в форме «Задания» пишет сюда её id; точка, контакт и
+--    пометка водителю берутся с площадки. NULL - адрес без площадки (как все заявки до 26.09).
+ALTER TABLE plan_orders
+  ADD COLUMN load_site_id INT DEFAULT NULL,
+  ADD COLUMN unload_site_id INT DEFAULT NULL,
+  ADD KEY k_load_site (load_site_id),
+  ADD KEY k_unload_site (unload_site_id);
+
+-- 2) Журнал правок площадки «было -> стало» (кто, когда). Создаётся и сам при старте api/lib/customer-sites.js;
+--    здесь - чтобы схема была записана. Время - UTC (DEFAULT CURRENT_TIMESTAMP), экран переводит в МСК.
+CREATE TABLE IF NOT EXISTS customer_site_history (
+  id BIGINT NOT NULL AUTO_INCREMENT,
+  site_id INT NOT NULL,
+  action VARCHAR(20) NOT NULL,          -- create | update | set_point | archive | restore
+  detail TEXT,                          -- JSON {"поле":["было","стало"]}
+  changed_by VARCHAR(255) DEFAULT NULL, -- email
+  changed_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  PRIMARY KEY (id),
+  KEY k_site (site_id)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
