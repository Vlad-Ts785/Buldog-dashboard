+// ── Б-5 (26.09): узнать площадку по написанию, площадка со 2-й заявки, «Сохранить как площадку» ──────────
+const SKIP_ADDR_ = /^\s*работа\s+по\s+месту\s*$/i;
+const LINK_KM_ = 3;     // своя точка заявки дальше этого от точки площадки - не привязываем (правило Б3)
+const MERGE_KM_ = 0.2;  // новое написание в пределах 200 м от точки площадки заказчика - та же площадка
+const SYS_ = "Система (площадки)";
+function ptOf(lat, lon) {
+  if (lat === null || lat === undefined || lon === null || lon === undefined || lat === "" || lon === "") return null;
+  const a = Number(lat), b = Number(lon);
+  return addressPoint.inRussia(a, b) ? { lat: a, lon: b } : null;
+}
+function kmApart(p, q) {
+  const R = 6371, rad = (x) => x * Math.PI / 180;
+  const dLa = rad(q.lat - p.lat), dLo = rad(q.lon - p.lon);
+  const h = Math.sin(dLa / 2) ** 2 + Math.cos(rad(p.lat)) * Math.cos(rad(q.lat)) * Math.sin(dLo / 2) ** 2;
+  return 2 * R * Math.asin(Math.sqrt(h));
+}
