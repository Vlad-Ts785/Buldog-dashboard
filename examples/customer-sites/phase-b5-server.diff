+    if (!text || SKIP_ADDR_.test(text)) continue;
+    const key = textKey(text), own = ptOf(o[side + "_lat"], o[side + "_lon"]);
+    if (!sites) sites = await listForCustomer(conn, o.customer, ent, { archived: true });
+    const withText = sites.filter((s) => s.texts.some((t) => textKey(t) === key));
+    if (withText.some((s) => s.archived) && !withText.some((s) => !s.archived)) continue; // место в архиве
